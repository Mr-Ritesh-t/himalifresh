# ─── DATABASE CONFIGURATION ───────────────────────────────────────────
# Production Database (Neon Serverless PostgreSQL):
DATABASE_URL="postgresql://username:password@ep-sample-pooler.neon.tech/neondb?sslmode=require"

# ─── AUTHENTICATION SECRET ──────────────────────────────────────────
# Generate a secure 32+ character key for JWT token encryption in production:
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET"

# ─── CLOUD IMAGE STORAGE (TIGRIS OBJECT STORAGE - RECOMMENDED) ───────
# Create bucket via `tigris mk himalifresh-images --public` & generate keys in Tigris Dashboard:
# TIGRIS_STORAGE_ACCESS_KEY_ID="tid_..."
# TIGRIS_STORAGE_SECRET_ACCESS_KEY="tsec_..."
# TIGRIS_STORAGE_BUCKET="himalifresh-images"
# TIGRIS_STORAGE_ENDPOINT="https://t3.storage.dev"

# ─── CLOUD IMAGE STORAGE (VERCEL BLOB FALLBACK) ─────────────────────
# Automatically added by Vercel when you click "Create Blob Store" in Vercel Storage tab:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─── BUSINESS INFORMATION DEFAULTS ──────────────────────────────────
NEXT_PUBLIC_BUSINESS_PHONE="+91 74777 68499"
NEXT_PUBLIC_WHATSAPP_NUMBER="917477768499"
NEXT_PUBLIC_BUSINESS_EMAIL="himalifresh@gmail.com"
NEXT_PUBLIC_BUSINESS_NAME="Himali Fresh"
NEXT_PUBLIC_BUSINESS_TAGLINE="The Spirit of Himalayas"
NEXT_PUBLIC_BUSINESS_ADDRESS="Dagapur, Siliguri, West Bengal, India"
NEXT_PUBLIC_APP_URL="https://himalifresh.com"

# ─── BREVO (SENDINBLUE) TRANSACTIONAL EMAILS ────────────────────────
# Get your API key from: Brevo Dashboard -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="himalifresh@gmail.com"
BREVO_SENDER_NAME="Himali Fresh"
BREVO_ADMIN_EMAIL="himalifresh@gmail.com"
